<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/arcade_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fullscreen Edge-to-Edge Wallpaper Image 1 -->
    <ImageView
        android:id="@+id/arcade_wallpaper_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Fullscreen Edge-to-Edge Wallpaper Image 2 (Crossfade target) -->
    <ImageView
        android:id="@+id/arcade_wallpaper_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient Scrim for contrast & readability (disabled per user request) -->
    <View
        android:id="@+id/arcade_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@drawable/arcade_scrim_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Header: Subtle System Name & Indicator -->
    <LinearLayout
        android:id="@+id/arcade_header_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/arcade_system_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text=""
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arcade_system_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.8"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#B0BEC5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Systems Carousel / Wheel RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/arcade_systems_list"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/arcade_legend_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arcade_header_layout"
        app:layout_constraintVertical_bias="0.55" />

    <!-- Embedded Android Apps View Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/arcade_apps_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D0101418"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/arcade_legend_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/arcade_apps_header_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/arcade_apps_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arcade_android_apps_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arcade_apps_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:alpha="0.75"
                android:text=""
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/arcade_apps_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/arcade_apps_header_box" />

        <ProgressBar
            android:id="@+id/arcade_apps_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider above the bottom legend bar -->
    <View
        android:id="@+id/arcade_legend_divider"
        style="@style/Divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.75"
        app:layout_constraintBottom_toTopOf="@+id/arcade_legend_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Native Docked Legend Bar (Arcade Mode) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/arcade_legend_bar"
        android:layout_width="0dp"
        android:layout_height="25dp"
        android:paddingTop="3dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/arcade_clock_text_view"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="1dp"
            android:gravity="center"
            android:paddingRight="4dp"
            android:text="00:00 am"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/arcade_tips_text_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="1dp"
            android:background="?selectableItemBackground"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:marqueeRepeatLimit="marquee_forever"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingLeft="4sp"
            android:paddingRight="4sp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:text="Daijishō retro launcher"
            android:textAllCaps="false"
            android:textColor="?colorControlNormal"
            android:textSize="12.25sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/arcade_btn_action_x"
            app:layout_constraintStart_toEndOf="@+id/arcade_clock_text_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <!-- Button X (OPÇÕES) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/arcade_btn_action_x"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.9"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/arcade_btn_action_a"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/arcade_menu_button_icon"
                android:layout_width="17dp"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/arcade_legend_menu_text"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_brightness_1_24"
                app:tint="?themeTextColor" />

            <TextView
                android:id="@+id/arcade_legend_menu_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/arcade_legend_menu"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/arcade_menu_icon_text_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="1dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="X"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="?themeBackgroundColor"
                android:textSize="9.75sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/arcade_menu_button_icon"
                app:layout_constraintEnd_toEndOf="@+id/arcade_menu_button_icon"
                app:layout_constraintStart_toStartOf="@+id/arcade_menu_button_icon"
                app:layout_constraintTop_toTopOf="@+id/arcade_menu_button_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Button A (SELECIONAR) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/arcade_btn_action_a"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.9"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/arcade_btn_action_b"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/arcade_select_button_icon"
                android:layout_width="17dp"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/arcade_legend_select_text"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_brightness_1_24"
                app:tint="?themeTextColor" />

            <TextView
                android:id="@+id/arcade_legend_select_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/arcade_legend_select"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/arcade_legend_btn_a_badge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="1dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="A"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="?themeBackgroundColor"
                android:textSize="9.75sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/arcade_select_button_icon"
                app:layout_constraintEnd_toEndOf="@+id/arcade_select_button_icon"
                app:layout_constraintStart_toStartOf="@+id/arcade_select_button_icon"
                app:layout_constraintTop_toTopOf="@+id/arcade_select_button_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Button B (VOLTAR) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/arcade_btn_action_b"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:alpha="0.9"
            android:background="?selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/arcade_back_button_icon"
                android:layout_width="17dp"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/arcade_legend_back_text"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_brightness_1_24"
                app:tint="?themeTextColor" />

            <TextView
                android:id="@+id/arcade_legend_back_text"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/arcade_legend_back"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/arcade_back_icon_text_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="1dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:text="B"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="?themeBackgroundColor"
                android:textSize="9.75sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/arcade_back_button_icon"
                app:layout_constraintEnd_toEndOf="@+id/arcade_back_button_icon"
                app:layout_constraintStart_toStartOf="@+id/arcade_back_button_icon"
                app:layout_constraintTop_toTopOf="@+id/arcade_back_button_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
