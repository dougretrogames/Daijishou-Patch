<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/arcade_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fullscreen Edge-to-Edge Wallpaper Image 1 -->
    <ImageView
        android:id="@+id/arcade_wallpaper_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Fullscreen Edge-to-Edge Wallpaper Image 2 (Crossfade target) -->
    <ImageView
        android:id="@+id/arcade_wallpaper_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gradient Scrim for contrast & readability -->
    <View
        android:id="@+id/arcade_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/arcade_scrim_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Header: Subtle System Name & Indicator -->
    <LinearLayout
        android:id="@+id/arcade_header_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/arcade_system_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text=""
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arcade_system_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.8"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#B0BEC5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Systems Carousel / Wheel RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/arcade_systems_list"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/arcade_legend_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/arcade_header_layout"
        app:layout_constraintVertical_bias="0.55" />

    <!-- Embedded Android Apps View Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/arcade_apps_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D0101418"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/arcade_legend_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/arcade_apps_header_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/arcade_apps_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arcade_android_apps_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arcade_apps_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:alpha="0.75"
                android:text=""
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/arcade_apps_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/arcade_apps_header_box" />

        <ProgressBar
            android:id="@+id/arcade_apps_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Centered Controller Legend Bar -->
    <LinearLayout
        android:id="@+id/arcade_legend_bar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/arcade_legend_pill_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Button X (OPÇÕES) - First on the left as in reference image -->
        <LinearLayout
            android:id="@+id/arcade_btn_action_x"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/ic_baseline_brightness_1_24"
                android:backgroundTint="#2979FF"
                android:gravity="center"
                android:text="X"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arcade_legend_menu_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/arcade_legend_menu"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Button A (SELECIONAR / INICIAR) - Center as in reference image -->
        <LinearLayout
            android:id="@+id/arcade_btn_action_a"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/arcade_legend_btn_a_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/ic_baseline_brightness_1_24"
                android:backgroundTint="#00C853"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arcade_legend_select_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/arcade_legend_select"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Button B (VOLTAR) - Right as in reference image -->
        <LinearLayout
            android:id="@+id/arcade_btn_action_b"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/ic_baseline_brightness_1_24"
                android:backgroundTint="#D50000"
                android:gravity="center"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/arcade_legend_back_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/arcade_legend_back"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
