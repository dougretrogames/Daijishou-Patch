<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/platform_library_list_item_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selectable_ripple_background"
    android:clickable="false"
    android:focusable="true"
    android:paddingLeft="8.0dp"
    android:paddingTop="4.25dp"
    android:paddingRight="8.0dp"
    android:paddingBottom="6.25dp">

    <TextView
        android:id="@id/platform_library_list_item_text_view"
        android:layout_width="0.0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2.0dp"
        android:alpha="0.87"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="TextView"
        android:textColor="?themeTextColor"
        android:textSize="16.7sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/platform_library_list_item_newly_image_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@id/platform_library_list_item_newly_image_view"
        android:layout_width="22.0dp"
        android:layout_height="17.0dp"
        android:paddingLeft="2.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/platform_library_list_item_favorite_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_auto_awesome_24"
        app:tint="@color/newly" />

    <ImageView
        android:id="@id/platform_library_list_item_favorite_image_view"
        android:layout_width="22.0dp"
        android:layout_height="17.0dp"
        android:paddingLeft="2.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/platform_library_list_item_completed_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_round_favorite_24"
        app:tint="@color/favorite" />

    <ImageView
        android:id="@id/platform_library_list_item_completed_image_view"
        android:layout_width="17.0dp"
        android:layout_height="17.0dp"
        android:paddingLeft="2.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/platform_library_list_item_recent_image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_baseline_check_circle_24"
        app:tint="@color/completed" />

    <ImageView
        android:id="@id/platform_library_list_item_recent_image_view"
        android:layout_width="22.0dp"
        android:layout_height="17.0dp"
        android:paddingLeft="2.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_twotone_brightness_1_24"
        app:tint="@color/activity" />

</androidx.constraintlayout.widget.ConstraintLayout>
