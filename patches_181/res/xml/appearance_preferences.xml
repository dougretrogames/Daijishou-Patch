<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/ui_interface_mode_category">
        <ListPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:key="ui_interface_mode"
            android:title="@string/ui_interface_mode_title"
            android:summary="@string/ui_interface_mode_summary"
            app:defaultValue="arcade"
            app:entries="@array/ui_interface_mode_array"
            app:entryValues="@array/ui_interface_mode_value_array"
            app:icon="@drawable/ic_baseline_sports_esports_24" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/arcade_settings_category">
        <ListPreference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/arcade_scroll_direction_title" android:key="arcade_scroll_direction" android:summary="@string/arcade_scroll_direction_summary" app:defaultValue="1" app:entries="@array/arcade_scroll_direction_array" app:entryValues="@array/arcade_scroll_direction_value_array" app:icon="@drawable/ic_outline_view_carousel_24" />
        <ListPreference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/arcade_android_apps_filter_title" android:key="arcade_android_apps_filter" android:summary="@string/arcade_android_apps_filter_summary" app:defaultValue="0" app:entries="@array/arcade_android_apps_filter_array" app:entryValues="@array/arcade_android_apps_filter_value_array" app:icon="@drawable/ic_baseline_android_24" />
    </PreferenceCategory>
    <Preference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/download_platform_wallpapers_pack_title" android:key="download_platform_wallpapers_pack_button" android:summary="@string/download_platform_wallpapers_pack_summary" app:icon="@drawable/ic_round_add_photo_alternate_24" />
    <PreferenceCategory android:title="@string/appearance_settings_title">
        <ListPreference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/library_collection_view_mode_title" android:key="library_collection_view_mode" android:summary="@string/library_collection_view_mode_summary" app:defaultValue="0" app:entries="@array/library_collection_view_mode_array" app:entryValues="@array/library_collection_view_mode_value_array" app:icon="@drawable/ic_baseline_sports_esports_24" />
        <ListPreference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/theme_color_title" android:key="theme_id" android:summary="@string/theme_color_summary" app:defaultValue="purple" app:entries="@array/theme_color_display_array" app:entryValues="@array/theme_color_value_array" app:icon="@drawable/ic_baseline_color_lens_24" />
        <ListPreference android:entries="@array/dark_mode_array" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/use_dark_theme_title" android:key="use_dark_theme" android:summary="@string/use_dark_theme_summary" app:defaultValue="0" app:entryValues="@array/dark_mode_value_array" app:icon="@drawable/round_dark_mode_24" />
        <SwitchPreferenceCompat android:icon="@drawable/twotone_dark_mode_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/use_pure_dark_theme_title" android:key="use_pure_dark_theme" android:summary="@string/use_pure_dark_theme_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/crossed_eye_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/hide_game_titles_title" android:key="hide_game_titles" android:summary="@string/hide_game_titles_description" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/square_outline_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/square_playable_item_title" android:key="square_playable_item_art" android:summary="@string/square_playable_item_description" android:defaultValue="false" />
        <Preference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/set_wallpaper_title" android:key="set_wallpaper_button" android:summary="@string/set_wallpaper_summary" app:icon="@drawable/ic_round_wallpaper_24" />
        <ListPreference android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/scale_ui_title" android:key="scale_ui" android:summary="@string/scale_ui_summary" app:defaultValue="1" app:entries="@array/scale_ui_array" app:entryValues="@array/scale_ui_value_array" app:icon="@drawable/ic_baseline_color_lens_24" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/platforms_page_title">
        <SwitchPreferenceCompat android:icon="@drawable/round_category_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/show_genres_in_platform_grid_view_title" android:key="show_genres_in_platform_grid_view" android:summary="@string/show_genres_in_platform_grid_view_summary" android:defaultValue="true" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_twotone_brightness_1_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/show_recent_indicators_title" android:key="show_recent_indicators" android:summary="@string/show_recent_indicators_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_baseline_aspect_ratio_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/enforce_platform_card_aspect_ratio_title" android:key="enforce_platform_card_aspect_ratio" android:defaultValue="true" app:summary="@string/enforce_platform_card_aspect_ratio_summary" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_round_auto_fix_high_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/use_auto_theme_color_title" android:key="use_auto_theme_color" android:summary="@string/use_auto_theme_color_summary" android:defaultValue="true" />
        <SwitchPreferenceCompat android:icon="@drawable/round_closed_caption_disabled_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/hide_library_page_title_title" android:key="hide_platforms_page_title" android:summary="@string/hide_library_page_title_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/round_subtitles_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/display_shortname_in_library_page_subtitle_title" android:key="display_shortname_in_platforms_page_subtitle" android:summary="@string/display_shortname_in_library_page_subtitle_summary" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/more_appearance_settings_title">
        <SwitchPreferenceCompat android:icon="@drawable/ic_outline_view_carousel_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/show_similar_items_title" android:key="show_similar_items" android:summary="@string/show_similar_items_summary" android:defaultValue="true" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_baseline_title_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/prettify_titles_title" android:key="prettify_titles" android:summary="@string/prettify_titles_summary" android:defaultValue="true" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_baseline_title_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/do_not_prettify_details_titles_title" android:key="do_not_prettify_titles_in_details_view" android:summary="@string/do_not_prettify_details_titles_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/outline_check_indeterminate_small_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/use_notifications_bar_title" android:key="show_notifications_bar" android:summary="@string/use_notifications_bar_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_baseline_access_time_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/use_24_hour_clock_title" android:key="use_24_hour_clock" android:summary="@string/use_24_hour_clock_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_baseline_sports_esports_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/swap_a_b_buttons_title" android:key="swap_a_b_buttons" android:summary="@string/swap_a_b_buttons_summary" android:defaultValue="false" />
        <SwitchPreferenceCompat android:icon="@drawable/baseline_screen_lock_portrait_24" android:layout_width="wrap_content" android:layout_height="wrap_content" android:title="@string/allow_portrait_mode_title" android:key="allow_portrait_mode" android:summary="@string/allow_portrait_mode_summary" android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
